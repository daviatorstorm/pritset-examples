# Copy the values below into your process environment. Do not commit a real .env file.
PRITSET_ACCESS_TOKEN=your-access-token
PRITSET_SECRET=your-secret
PRITSET_TEMPLATE_ID=your-template-id

# Optional: required only by the webhook example.
PRITSET_WEBHOOK_URL=https://example.com/webhooks/pritset

# Optional PHP-only TLS workaround. Use a trusted PEM CA bundle supplied by
# your operating system, PHP distribution, or Git for Windows.
# PRITSET_CA_BUNDLE_PATH=C:\path\to\ca-bundle.crt
